<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prayer_times"
        android:textSize="@dimen/text_size_xl"
        android:textStyle="bold"
        android:textColor="?attr/colorTitle"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- Hijri Date -->
    <TextView
        android:id="@+id/text_hijri_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorHijriDate"
        android:textSize="@dimen/text_size_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone" />

    <!-- Subtle divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorAccentText"
        android:alpha="0.3"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <!-- Location Error Card — shown when no GPS fix and no cached location -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_location_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/location_unavailable_title"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold"
                android:textColor="?attr/colorTitle"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/location_unavailable_message"
                android:textSize="@dimen/text_size_sm"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_location_retry"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enable_location"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_location" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_location_manually"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_location_manually" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Location Source Indicator -->
    <TextView
        android:id="@+id/text_location_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/location_source_gps"
        android:textSize="@dimen/text_size_xs"
        android:textColor="?android:attr/textColorSecondary"
        android:alpha="0.6"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone" />

    <!-- RecyclerView wrapped in NestedScrollView for better scroll behavior -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_prayer_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_md" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
