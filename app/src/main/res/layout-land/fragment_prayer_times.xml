<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prayer_times"
        android:textSize="@dimen/text_size_xl"
        android:textStyle="bold"
        android:textColor="?attr/colorTitle"
        android:layout_marginBottom="@dimen/spacing_md" />

    <!-- Hijri Date -->
    <TextView
        android:id="@+id/text_hijri_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorHijriDate"
        android:textSize="@dimen/text_size_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone" />

    <!-- Subtle divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorAccentText"
        android:alpha="0.3"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <!-- Two-column grid: prayer list (60%) + empty/next prayer summary (40%) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="10">

        <!-- Prayer list column (60%) -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/bottom_nav_height"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_prayer_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_sm" />

        </androidx.core.widget.NestedScrollView>

        <!-- Right column (40%) — next prayer summary -->
        <LinearLayout
            android:id="@+id/layout_next_prayer_summary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_next_prayer"
                android:textSize="@dimen/text_size_md"
                android:textColor="?attr/colorTitle"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/text_next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_xl"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/text_next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_xxl"
                android:textStyle="bold"
                android:textColor="?attr/colorAccentText"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <TextView
                android:id="@+id/text_next_prayer_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_sm"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
