<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: block ALL cleartext (HTTP) traffic — banking safety preserved.
         Only the domain-config blocks below override this for specific local IPs. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- ============================================================
         LOCAL / PRIVATE NETWORK CLEARTEXT EXCEPTIONS
         ============================================================
         Android's network-security-config does NOT support IP wildcards
         or CIDR ranges.  Each <domain> entry matches an EXACT hostname
         or IP address.  includeSubdomains only applies to DNS names,
         not to IP octets.

         The entries below cover:
           • The user's Wi-Fi log-server IP (192.168.105.79)
           • Common home/office gateway and device IPs in 192.168.x.x
           • Android emulator host bridge (10.0.2.2) and common 10.x.x.x
           • Common 172.16-31.x.x Docker/container IPs
           • localhost / 127.0.0.1 for on-device testing

         If the log server moves to a different IP, add that IP here.
         ============================================================ -->

    <!-- 192.168.x.x — home / office networks (most common subnets) -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- User's actual log-server IPs -->
        <domain includeSubdomains="false">192.168.2.17</domain>
        <domain includeSubdomains="false">192.168.105.79</domain>
        <domain includeSubdomains="false">192.168.105.99</domain>

        <!-- Common home router gateways & device ranges on 192.168.2.x (192.168.2.1 - 192.168.2.50) -->
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">192.168.2.2</domain>
        <domain includeSubdomains="false">192.168.2.3</domain>
        <domain includeSubdomains="false">192.168.2.4</domain>
        <domain includeSubdomains="false">192.168.2.5</domain>
        <domain includeSubdomains="false">192.168.2.6</domain>
        <domain includeSubdomains="false">192.168.2.7</domain>
        <domain includeSubdomains="false">192.168.2.8</domain>
        <domain includeSubdomains="false">192.168.2.9</domain>
        <domain includeSubdomains="false">192.168.2.10</domain>
        <domain includeSubdomains="false">192.168.2.11</domain>
        <domain includeSubdomains="false">192.168.2.12</domain>
        <domain includeSubdomains="false">192.168.2.13</domain>
        <domain includeSubdomains="false">192.168.2.14</domain>
        <domain includeSubdomains="false">192.168.2.15</domain>
        <domain includeSubdomains="false">192.168.2.16</domain>
        <domain includeSubdomains="false">192.168.2.18</domain>
        <domain includeSubdomains="false">192.168.2.19</domain>
        <domain includeSubdomains="false">192.168.2.20</domain>
        <domain includeSubdomains="false">192.168.2.21</domain>
        <domain includeSubdomains="false">192.168.2.22</domain>
        <domain includeSubdomains="false">192.168.2.23</domain>
        <domain includeSubdomains="false">192.168.2.24</domain>
        <domain includeSubdomains="false">192.168.2.25</domain>
        <domain includeSubdomains="false">192.168.2.26</domain>
        <domain includeSubdomains="false">192.168.2.27</domain>
        <domain includeSubdomains="false">192.168.2.28</domain>
        <domain includeSubdomains="false">192.168.2.29</domain>
        <domain includeSubdomains="false">192.168.2.30</domain>
        <domain includeSubdomains="false">192.168.2.31</domain>
        <domain includeSubdomains="false">192.168.2.32</domain>
        <domain includeSubdomains="false">192.168.2.33</domain>
        <domain includeSubdomains="false">192.168.2.34</domain>
        <domain includeSubdomains="false">192.168.2.35</domain>
        <domain includeSubdomains="false">192.168.2.36</domain>
        <domain includeSubdomains="false">192.168.2.37</domain>
        <domain includeSubdomains="false">192.168.2.38</domain>
        <domain includeSubdomains="false">192.168.2.39</domain>
        <domain includeSubdomains="false">192.168.2.40</domain>
        <domain includeSubdomains="false">192.168.2.41</domain>
        <domain includeSubdomains="false">192.168.2.42</domain>
        <domain includeSubdomains="false">192.168.2.43</domain>
        <domain includeSubdomains="false">192.168.2.44</domain>
        <domain includeSubdomains="false">192.168.2.45</domain>
        <domain includeSubdomains="false">192.168.2.46</domain>
        <domain includeSubdomains="false">192.168.2.47</domain>
        <domain includeSubdomains="false">192.168.2.48</domain>
        <domain includeSubdomains="false">192.168.2.49</domain>
        <domain includeSubdomains="false">192.168.2.50</domain>

        <!-- 192.168.0.x / 192.168.1.x / other subnets -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.10.1</domain>
        <domain includeSubdomains="false">192.168.50.1</domain>
        <domain includeSubdomains="false">192.168.100.1</domain>
        <domain includeSubdomains="false">192.168.254.1</domain>
        <!-- Common server / dev-machine IPs on those subnets -->
        <domain includeSubdomains="false">192.168.0.100</domain>
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.1.101</domain>
        <domain includeSubdomains="false">192.168.1.102</domain>
        <domain includeSubdomains="false">192.168.2.100</domain>
        <domain includeSubdomains="false">192.168.10.100</domain>
        <domain includeSubdomains="false">192.168.50.100</domain>
        <domain includeSubdomains="false">192.168.105.1</domain>
        <domain includeSubdomains="false">192.168.105.100</domain>
        <domain includeSubdomains="false">192.168.105.200</domain>
    </domain-config>

    <!-- 10.x.x.x — corporate networks & Android emulator host bridge -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator host bridge -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <!-- Common corporate / lab IPs -->
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.100</domain>
        <domain includeSubdomains="false">10.0.1.1</domain>
        <domain includeSubdomains="false">10.0.1.100</domain>
    </domain-config>

    <!-- 172.16.x.x – 172.31.x.x — Docker / container / VM subnets -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.16.0.1</domain>
        <domain includeSubdomains="false">172.17.0.1</domain>
        <domain includeSubdomains="false">172.17.0.2</domain>
        <domain includeSubdomains="false">172.18.0.1</domain>
        <domain includeSubdomains="false">172.19.0.1</domain>
        <domain includeSubdomains="false">172.20.0.1</domain>
        <domain includeSubdomains="false">172.21.0.1</domain>
        <domain includeSubdomains="false">172.22.0.1</domain>
        <domain includeSubdomains="false">172.23.0.1</domain>
        <domain includeSubdomains="false">172.24.0.1</domain>
        <domain includeSubdomains="false">172.25.0.1</domain>
        <domain includeSubdomains="false">172.26.0.1</domain>
        <domain includeSubdomains="false">172.27.0.1</domain>
        <domain includeSubdomains="false">172.28.0.1</domain>
        <domain includeSubdomains="false">172.29.0.1</domain>
        <domain includeSubdomains="false">172.30.0.1</domain>
        <domain includeSubdomains="false">172.31.0.1</domain>
    </domain-config>

    <!-- localhost / loopback for on-device testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.0</domain>
    </domain-config>
</network-security-config>
