<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    WCAG AA Contrast Ratios (Light Theme)
    text_primary (#1C1B1F) on background (#FFF8F0) = 16.8:1 (pass)
    colorOnSurface (#1C1B1F) on card (#FFFFFF) = 17.6:1 (pass)
    colorTitle (#7A6215) on background (#FFF8F0) = 5.5:1 (pass)
    colorOnPrimary (navy #060D16) on gold (#C9A227) = 8.1:1 (pass)
    All combinations meet WCAG AA minimum 4.5:1.
    -->
    <!-- Base theme: uses DayNight so AppCompatDelegate.setDefaultNightMode() controls
         whether the Light or Dark variant is shown. -->
    <style name="Theme.MosqueDND" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary / Accent (shared between light and dark) -->
        <item name="colorPrimary">@color/gold_primary</item>
        <!-- WCAG AA: navy_dark (#060D16) on gold (#C9A227) = 8.1:1 -->
        <item name="colorOnPrimary">@color/navy_dark</item>
        <item name="colorPrimaryContainer">@color/gold_light</item>
        <item name="colorOnPrimaryContainer">@color/navy_dark</item>
        <item name="colorSecondary">@color/gold_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Light-specific backgrounds and surfaces -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="colorOnBackground">@color/light_on_background</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/light_on_surface_variant</item>

        <!-- Custom themeable attributes (light variant) -->
        <item name="colorTitle">@color/gold_dark_accessible</item>
        <item name="colorHijriDate">@color/gold_dark_accessible</item>
        <item name="colorAccentText">@color/gold_dark_accessible</item>

        <!-- Calibration dot colors (accessible on light background) -->
        <item name="colorCalibrationDotHigh">#2E7D32</item>
        <item name="colorCalibrationDotMedium">#F9A825</item>
        <item name="colorCalibrationDotLow">#C62828</item>

        <!-- Emerald/Gold compass colors (light mode) -->
        <item name="colorCompassBg">@color/compass_bg</item>
        <item name="colorCompassGoldPrimary">@color/compass_gold_primary</item>
        <item name="colorCompassGoldLight">@color/compass_gold_light</item>
        <item name="colorCompassGoldDark">@color/compass_gold_dark</item>
        <item name="colorCompassIvory">@color/compass_ivory</item>
        <item name="colorCompassEmerald">@color/compass_emerald</item>
        <item name="colorCompassKaabaBody">@color/compass_kaaba_body</item>
        <item name="colorCompassKaabaRoof">@color/compass_kaaba_roof</item>
    </style>

    <style name="Theme.MosqueDND.AppBarOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="colorPrimary">@color/gold_primary</item>
    </style>

    <style name="Theme.MosqueDND.PopupOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">@color/light_surface</item>
    </style>

    <!-- Bottom Navigation: reduced text sizes for 48dp height bar (4 items) -->
    <style name="TextAppearance.MosqueDND.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MosqueDND.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Bottom Navigation widget style: tighter padding, smaller icons, compact text -->
    <style name="Widget.MosqueDND.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.MosqueDND.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.MosqueDND.BottomNav.Inactive</item>
    </style>

    <!-- Compact theme toggle button for single-line layout -->
    <style name="Widget.MosqueDND.ThemeButton.Compact" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Preference row theme overlay: consistent minHeight, padding, and vertical alignment -->
    <style name="ThemeOverlay.MosqueDND.PreferenceScreen" parent="ThemeOverlay.AppCompat">
        <item name="preferenceCategoryStyle">@style/Preference.MosqueDND.Row</item>
        <item name="preferenceStyle">@style/Preference.MosqueDND.Row</item>
        <item name="preferenceInformationStyle">@style/Preference.MosqueDND.Row</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.MosqueDND.SwitchRow</item>
    </style>

    <!-- Preference row with consistent minHeight and center_vertical alignment -->
    <style name="Preference.MosqueDND.Row" parent="Preference">
        <item name="android:layout">@layout/pref_row</item>
    </style>

    <!-- Switch row with help button, matching unified row dimensions -->
    <style name="Preference.MosqueDND.SwitchRow" parent="Preference">
        <item name="android:layout">@layout/pref_switch_with_help</item>
    </style>
</resources>
